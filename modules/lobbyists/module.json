{
	"schema_version": 1,
	"id": "lobbyists",
	"name": "提案人模组",
	"version": "0.1.0",
	"priority": 120,
	"dependencies": ["base_rules", "base_employees", "base_pieces", "base_tiles", "base_maps"],
	"conflicts": [],
	"entry_script": "res://modules/lobbyists/rules/entry.gd",
	"provides": {
		"content": ["employees", "milestones", "pieces", "tiles"],
		"effects": [
			"lobbyists:dinnertime:distance_delta:roadworks",
			"lobbyists:dinnertime:sale_house_bonus:park"
		],
		"ui": {
			"placement_overlays": [
				"res://modules/lobbyists/ui/lobbyists_extra_tile_flow_controller.gd"
			],
			"map_interaction_modes": [
				{
					"id": "lobbyists_extra_tile",
					"script": "res://modules/lobbyists/ui/game_map_interaction_lobbyists_extra_tile_mode.gd"
				}
			],
			"hidden_action_ids": [
				"place_lobbyists_extra_map_tile",
				"skip_lobbyists_extra_map_tile"
			],
			"module_selector": {
				"group_id": "map_expansion",
				"group_title": "地图变体",
				"group_order": 40,
				"order": 1
			},
			"setup_constraints": {
				"requires_optional_modules": [
					{
						"required_player_counts": [5, 6],
						"module_ids": ["new_districts"],
						"reason": "5/6 人局启用提案人模组时强制启用新区域模组，以提供额外地图板块。"
					}
				]
			}
		}
	}
}
