# Copy to .env and fill in production values before `docker compose up -d`.
# For HTTPS deployment, Traefik will request certificates via Cloudflare DNS-01.

# Images
FCM_TAG=latest
FCM_SERVER_IMAGE=ghcr.io/ygowill/food_chain_magnate/fcm-server:latest
FCM_WEB_IMAGE=ghcr.io/ygowill/food_chain_magnate/fcm-web:latest
FCM_BACKEND_IMAGE=ghcr.io/ygowill/food_chain_magnate/fcm-backend:latest

# Container names
FCM_SERVER_NAME=fcm-server
FCM_WEB_NAME=fcm-web
FCM_BACKEND_NAME=fcm-backend

# Ports / domains
FCM_SERVER_PORT=7000
FCM_SERVER_BIND=0.0.0.0
FCM_WEB_PORT=8080
FCM_HTTP_PORT=18080
FCM_HTTPS_PORT=18443
FCM_WEB_DOMAIN=fcmapp.ygowill.net
FCM_WS_DOMAIN=ws.fcmapp.ygowill.net
FCM_WEB_ORIGIN=https://fcmapp.ygowill.net:18443
FCM_DEFAULT_WS_URL=wss://fcmapp.ygowill.net:18443/ws
FCM_ACME_KEY_TYPE=EC256

# Secrets
FCM_HMAC_SECRET=change-me-in-production
FCM_INTERNAL_API_SECRET=change-me-in-production-too
FCM_ADMIN_USER_IDS=
FCM_ADMIN_EMAIL=
FCM_ADMIN_PASSWORD=
FCM_ADMIN_DISPLAY_NAME=Admin

# Database
FCM_DB_USER=fcm
FCM_DB_PASSWORD=change-me-db-password
FCM_DB_NAME=fcm

# Let's Encrypt / Cloudflare DNS-01
ACME_EMAIL=you@example.com
CF_DNS_API_TOKEN=replace-with-cloudflare-token

# Optional mirrors / accelerators
FCM_DOCKER_IO_PREFIX=
FCM_DOCKER_API_VERSION=
FCM_TRAEFIK_DYNAMIC_FILE=./traefik_dynamic.yml
